    "react-day-picker": "9.8.1",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
