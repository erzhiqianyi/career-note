# Copy to .dev.vars; Firebase Console > Project settings > Your apps > Web app.
CAREER_AUTH_MODE=strict
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=your-web-app-id
CAREER_ADMIN_UIDS=

# OAuth token lifetimes for AI agents (optional).
# CAREER_OAUTH_REFRESH_DAYS: refresh token lifetime (default 90). MCP_TOKEN_TTL_DAYS: access token lifetime (default 30).
# The public address is NOT set here: `npm run dev` stays local, and `npm run dev:tunnel`
# takes CAREER_TUNNEL / CAREER_PUBLIC_ORIGIN from .env (see .env.example).
# CAREER_OAUTH_REFRESH_DAYS=90

# MCP inspector at http://127.0.0.1:4211/api/career/mcp/inspector (also via the web port). Always on in
# auth mode off (local only); set CAREER_INSPECTOR=true to enable it in on/strict mode. Never in production.
# CAREER_INSPECTOR=true

# Hosted deployment only (set with `wrangler secret put`, see docs/deployment.md):
# CAREER_WEB_ORIGIN=https://career.example.com        # the Pages site; allowed for CORS, hosts the consent page
# CAREER_PUBLIC_ORIGIN=https://career-api.example.com  # this Worker's own address, announced in OAuth metadata
# CAREER_CORS_ORIGINS=https://another-client.example.com  # extra browser origins, comma separated
