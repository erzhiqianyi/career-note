# Launcher configuration. Empty data path uses ~/.local/share/career-note.
CAREER_DATA_DIR=
CAREER_WEB_PORT=4210
CAREER_API_PORT=4211
# Optional overrides:
# CAREER_API_PROXY=http://127.0.0.1:4211
# CAREER_WRANGLER_CONFIG=wrangler.toml
# `npm run dev:tunnel` only (plain `npm run dev` ignores these):
# a named cloudflared tunnel you already run, and the https hostname its ingress routes to 127.0.0.1:4210 (web; the
# whole app incl. MCP is public) or 127.0.0.1:4211 (API only; the consent page stays on localhost).
# Leave both unset to get a throwaway trycloudflare address instead.
# CAREER_TUNNEL=my-tunnel
# CAREER_PUBLIC_ORIGIN=https://career-local.example.com
# Static build only: address of a hosted API Worker to bake into the site (docs/deployment.md).
# Leave unset for local dev; the dev server proxies /api/career to the local Worker.
# NEXT_PUBLIC_CAREER_API_URL=https://career-api.example.com
